# ==============================================================================
# CINEFORGE AI - Master Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# NEVER commit real credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="CineForge AI"
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public Configuration
NEXT_PUBLIC_APP_NAME="CineForge AI"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Security & Authentication
# Generate a secure 32+ byte key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cineforge-insecure-dev-secret-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL in production; SQLite fallback supported in dev)
# PostgreSQL: postgresql+asyncpg://cineforge_user:cineforge_password@localhost:5432/cineforge_db
# SQLite (Dev fallback): sqlite+aiosqlite:///./cineforge.db
DATABASE_URL=sqlite+aiosqlite:///./cineforge.db
DATABASE_ECHO=false

# Redis & Background Queue (Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage/uploads
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=cineforge-assets
S3_REGION=us-east-1

# External AI Video Providers
# Options: replicate, fal, mock (for offline zero-cost testing)
DEFAULT_VIDEO_PROVIDER=mock
REPLICATE_API_TOKEN=
FAL_KEY=

# Optional LLM Provider (Prompt Enhancement & Storyboard)
# Options: mock, openai, gemini
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Media Processing & Limits
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","webp"]
ALLOWED_VIDEO_EXTENSIONS=["mp4","webm","mov"]
GENERATION_CONCURRENCY_PER_USER=2
MAX_GENERATION_TIMEOUT_SECONDS=600

# Error Monitoring (Optional)
SENTRY_DSN=

